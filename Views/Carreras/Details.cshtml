@model GestionFacultadesCarreras.Models.Carrera

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Carrera</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Nombre de la Carrera
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>

        <dt class="col-sm-2">
            Duración (Semestres)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DuracionSemestres)
        </dd>

        <dt class="col-sm-2">
            Modulación
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Modulacion)
        </dd>

        <dt class="col-sm-2">
            Facultad
        </dt>
        <dd class="col-sm-10">
            @(Model.Facultad?.Nombre ?? "Sin facultad")
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
